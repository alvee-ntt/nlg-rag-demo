# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=innovationsademo
AZURE_STORAGE_CONTAINER=nlg-agent-navigator
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_VERIFY_SSL=false

# Optional: limit ingestion to one or more folder prefixes.
# Leave empty to ingest the full container.
# Example: flexlife,iul,sales-content,shared
AZURE_BLOB_PREFIXES=flexlife,iul,sales-content,shared

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# OpenAI or Azure OpenAI
# Use "openai" or "azure_openai"
MODEL_PROVIDER=azure_openai

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://nlg-test-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini

# Embedding/vector settings
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Ingestion controls
BATCH_SIZE=50
FORCE_REINDEX=false





AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_VOICE_AVA=en-US-Ava:DragonHDLatestNeural
AZURE_SPEECH_VOICE_ANDREW=en-US-Andrew:DragonHDLatestNeural
